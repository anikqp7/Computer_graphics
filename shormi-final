void drawFlowers()
{
    drawFlower(70,   525, rgb(240, 80, 100));
    drawFlower(120,  530, rgb(255, 190, 40));
    drawFlower(190,  525, rgb(190, 90, 220));

    drawFlower(1010, 525, rgb(240, 100, 130));
    drawFlower(1080, 520, rgb(245, 200, 50));
    drawFlower(1140, 530, rgb(170, 100, 230));
}


// ============================================================
// RAIN
// ============================================================

void drawRain()
{
    setcolor(nightMode ? rgb(110, 150, 180)
                       : rgb(180, 215, 235));

    for (int i = 0; i < 160; i++)
    {
        int x = (i * 79 + rainFrame * 9)  % (WIDTH + 100);
        int y = (i * 53 + rainFrame * 14) % HEIGHT;

        line(x, y, x - 7, y + 15);
    }
}


// ============================================================
// CONTROLS
// ============================================================

void drawControls()
{
    setfillstyle(SOLID_FILL, rgb(22, 32, 40));
    bar(15, 650, 720, 688);

    setbkcolor(rgb(22, 32, 40));
    setcolor(WHITE);
    settextstyle(DEFAULT_FONT, HORIZ_DIR, 1);

    char text[200];
    sprintf(text,
        "D: Day/Night   R: Rain %s   +/-: Waterfall Speed [%d]   ESC: Exit",
        rainOn ? "ON" : "OFF", waterSpeed);

    outtextxy(28, 664, text);
}


// ============================================================
// COMPLETE SCENE
// ============================================================

void drawScene()
{
    drawSky();
    drawSunMoon();
    drawClouds();

    drawMountains();
    drawCliff();

    drawRiver();
    drawGrassArea();

    drawWaterfall();

    // Trees
    drawTree(85,   515, 90);
    drawTree(1120, 510, 100);
    drawTree(275,  510, 55);
    drawTree(930,  515, 60);

    // Foreground bushes
    drawBush(25,   525, 26);
    drawBush(225,  528, 22);
    drawBush(965,  522, 25);
    drawBush(1180, 527, 30);

    // Rocks
    drawRock(410, 535, 32);
    drawRock(770, 535, 35);
    drawRock(340, 550, 20);
    drawRock(855, 548, 22);

    // Fish
    drawFish(fishX1, 610, rgb(245, 145, 45), true);
    drawFish(fishX2, 650, rgb(235, 90,  90), false);

    drawPerson();
    drawBirds();
    drawFlowers();

    if (rainOn) drawRain();

    drawControls();
}


// ============================================================
// UPDATE
// ============================================================

void updateAnimation()
{
    cloudX1 += 1;
    if (cloudX1 > WIDTH + 150) cloudX1 = -180;

    if (waveFrame % 2 == 0) cloudX2 += 1;
    if (cloudX2 > WIDTH + 150) cloudX2 = -200;

    birdX += 3;
    if (birdX > WIDTH + 150) birdX = -150;

    fishX1 += 2;
    if (fishX1 > WIDTH + 50) fishX1 = -50;

    fishX2 -= 2;
    if (fishX2 < -50) fishX2 = WIDTH + 50;

    waterfallFrame++;
    waveFrame++;
    rainFrame++;
}


// ============================================================
// KEYBOARD
// ============================================================

bool handleKeyboard()
{
    if (kbhit())
    {
        int k = getch();

        if (k == 27) return false;

        if (k == 'd' || k == 'D') nightMode = !nightMode;
        if (k == 'r' || k == 'R') rainOn    = !rainOn;

        if ((k == '+' || k == '=') && waterSpeed < 8) waterSpeed++;
        if ((k == '-' || k == '_') && waterSpeed > 1) waterSpeed--;
    }
    return true;
}


// ============================================================
// MAIN
// ============================================================

int main()
{
    srand((unsigned) time(NULL));

    initwindow(WIDTH, HEIGHT, "Waterfall Paradise");

    bool running = true;

    while (running)
    {
        currentPage = 1 - currentPage;
        setactivepage(currentPage);
        cleardevice();

        drawScene();

        setvisualpage(currentPage);

        running = handleKeyboard();
        updateAnimation();

        delay(25);
    }

    closegraph();
    return 0;
}
