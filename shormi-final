const int WIDTH  = 1200;
const int HEIGHT = 700;

bool nightMode = false;
bool rainOn    = false;

int cloudX1 = 80;
int cloudX2 = 650;
int birdX   = 150;

int fishX1 = 100;
int fishX2 = 850;

int waterfallFrame = 0;
int waveFrame      = 0;
int rainFrame      = 0;

int waterSpeed  = 3;
int currentPage = 0;


// ============================================================
// HELPERS
// ============================================================

int rgb(int r, int g, int b)
{
    return COLOR(r, g, b);
}

void filledCircle(int x, int y, int radius, int color)
{
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    fillellipse(x, y, radius, radius);
}


// ============================================================
// SKY
// ============================================================

void drawSky()
{
    int topR, topG, topB;
    int botR, botG, botB;

    if (!nightMode)
    {
        topR = 70;  topG = 140; topB = 210;
        botR = 190; botG = 225; botB = 240;
    }
    else
    {
        topR = 6;   topG = 15;  topB = 38;
        botR = 30;  botG = 55;  botB = 85;
    }

    for (int y = 0; y < 505; y += 5)
    {
        int r = topR + (botR - topR) * y / 505;
        int g = topG + (botG - topG) * y / 505;
        int b = topB + (botB - topB) * y / 505;

        setfillstyle(SOLID_FILL, rgb(r, g, b));
        bar(0, y, WIDTH, y + 5);
    }
}


// ============================================================
// SUN / MOON / STARS
// ============================================================

void drawSunMoon()
{
    if (!nightMode)
    {
        filledCircle(1010, 105, 60, rgb(255, 210, 70));
        filledCircle(1010, 105, 47, rgb(255, 230, 100));
        filledCircle(1010, 105, 34, rgb(255, 245, 175));
    }
    else
    {
        int stars[][2] =
        {
            {70,70}, {150,120}, {230,55}, {315,120},
            {390,55},{475,140}, {565,70}, {655,110},
            {745,50},{835,150},{900,70},{1090,160},
            {1140,65},{520,185},{275,180},{960,200},
            {430,90},{620,170},{800,90},{140,190}
        };

        for (int i = 0; i < 20; i++)
        {
            int r = ((waveFrame + i) % 5 == 0) ? 2 : 1;
            filledCircle(stars[i][0], stars[i][1], r,
                         rgb(240, 240, 210));
        }

        // Moon
        filledCircle(1010, 105, 45, rgb(245, 245, 210));
        filledCircle(1028, 90,  42, rgb(15, 30, 60));
    }
}


// ============================================================
// CLOUDS
// ============================================================

void drawOneCloud(int x, int y, int size)
{
    int c  = nightMode ? rgb(105, 115, 135)
                       : rgb(245, 248, 250);

    int sh = nightMode ? rgb(70, 80, 100)
                       : rgb(200, 218, 228);

    setfillstyle(SOLID_FILL, sh);
    fillellipse(x + 45, y + 12, 55 * size / 100,
                                17 * size / 100);

    setfillstyle(SOLID_FILL, c);

    fillellipse(x,                   y,
                35 * size / 100, 20 * size / 100);
    fillellipse(x + 35 * size / 100, y - 14 * size / 100,
                38 * size / 100, 30 * size / 100);
    fillellipse(x + 72 * size / 100, y,
                42 * size / 100, 23 * size / 100);
    fillellipse(x + 105 * size / 100,y + 3,
                30 * size / 100, 18 * size / 100);

    bar(x, y,
        x + 105 * size / 100,
        y + 15 * size / 100);
}

void drawClouds()
{
    drawOneCloud(cloudX1, 115, 85);
    drawOneCloud(cloudX2, 155, 100);
    drawOneCloud((cloudX1 + 430) % 1350 - 100, 65, 60);
}


