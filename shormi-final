// ============================================================
// CLIFF
// ============================================================

void drawCliff()
{
    int rock  = nightMode ? rgb(45, 50, 45)
                          : rgb(82, 85, 68);
    int light = nightMode ? rgb(65, 68, 60)
                          : rgb(115, 110, 82);

    setfillstyle(SOLID_FILL, rock);

    int L[] = {420,315,510,270,540,300,
               532,510,415,525,378,445};
    fillpoly(6, L);

    int R[] = {660,290,708,308,808,445,
               755,520,662,510};
    fillpoly(5, R);

    setfillstyle(SOLID_FILL, light);

    int d1[] = {442,342,505,300,493,382,448,405};
    fillpoly(4, d1);

    int d2[] = {680,332,720,352,762,432,700,408};
    fillpoly(4, d2);

    // Moss dots
    int moss = nightMode ? rgb(35, 78, 44)
                         : rgb(50, 130, 55);

    for (int i = 0; i < 25; i++)
    {
        int x = 400 + (i * 37) % 350;
        int y = 320 + (i * 53) % 180;

        if (x < 520 || x > 675)
            filledCircle(x, y, 3, moss);
    }
}


// ============================================================
// RIVER
// ============================================================

void drawRiver()
{
    int upper = nightMode ? rgb(25, 78, 108)
                          : rgb(38, 145, 195);

    int deep  = nightMode ? rgb(17, 58, 88)
                          : rgb(24, 108, 165);

    setfillstyle(SOLID_FILL, upper);
    bar(0, 505, WIDTH, HEIGHT);

    setfillstyle(SOLID_FILL, deep);
    bar(0, 615, WIDTH, HEIGHT);

    // Waves
    for (int row = 0; row < 6; row++)
    {
        int y = 530 + row * 27;
        int offset = (waveFrame * ((row % 2) ? 2 : 1)) % 70;

        for (int x = -70 + offset; x < WIDTH; x += 80)
        {
            if (row % 2 == 0)
                setcolor(rgb(135, 205, 225));
            else
                setcolor(rgb(75, 175, 210));

            arc(x, y, 15, 165, 28);
        }
    }

    // Waterfall reflection
    for (int i = 0; i < 7; i++)
    {
        int w = 100 - i * 9;
        int y = 565 + i * 18;

        if (i % 2)
            setcolor(rgb(120, 195, 220));
        else
            setcolor(rgb(170, 220, 235));

        line(600 - w / 2, y, 600 + w / 2, y);
    }

    // Shimmer
    for (int i = 0; i < 35; i++)
    {
        int x = (i * 97 + waveFrame * (1 + i % 2)) % WIDTH;
        int y = 535 + (i * 37) % 145;
        int L = 10 + (i * 13) % 35;

        if (i % 3 == 0)
            setcolor(rgb(170, 220, 235));
        else
            setcolor(rgb(75, 165, 200));

        line(x, y, x + L, y);
    }

    // Foreground ripples
    setcolor(rgb(145, 210, 230));

    for (int x = 30; x < WIDTH; x += 120)
    {
        int m = (waveFrame + x) % 40;
        arc(x + m, 670, 20, 160, 30);
    }
}


// ============================================================
// WATERFALL
// ============================================================

void drawWaterfall()
{
    // Darker back layer
    int shadow = nightMode ? rgb(55, 105, 135)
                           : rgb(75, 155, 190);

    setfillstyle(SOLID_FILL, shadow);

    int body[] =
    {
        535,285,665,285,668,350,660,410,
        670,470,658,525,640,545,550,545,
        532,520,540,455,530,395,538,340
    };
    fillpoly(12, body);

    // Main lighter water
    int water = nightMode ? rgb(105, 165, 195)
                          : rgb(135, 210, 235);

    setfillstyle(SOLID_FILL, water);

    int center[] =
    {
        550,285,650,285,654,345,646,405,
        657,465,648,520,635,540,558,540,
        545,515,550,450,542,395
    };
    fillpoly(11, center);

    // Flowing streams
    for (int i = 0; i < 18; i++)
    {
        int x = 542 + i * 7;
        int off = (waterfallFrame * waterSpeed + i * 19) % 55;

        int col;
        if      (i % 4 == 0) col = rgb(245, 252, 255);
        else if (i % 3 == 0) col = rgb(195, 235, 248);
        else                 col = rgb(155, 215, 240);

        setcolor(col);
        setlinestyle(SOLID_LINE, 0, (i % 5 == 0) ? 3 : 1);

        for (int y = 290 + off; y < 515; y += 55)
        {
            int bend = (i % 3) - 1;
            line(x, y, x + bend * 3, y + 25 + (i % 4) * 3);
        }
    }

    setlinestyle(SOLID_LINE, 0, 1);

    // Bright thin streams
    setcolor(rgb(235, 250, 255));

    for (int i = 0; i < 7; i++)
    {
        int x = 550 + i * 17;
        int s = (waterfallFrame * waterSpeed + i * 15) % 40;

        for (int y = 300 + s; y < 500; y += 60)
            line(x, y, x - 2, y + 30);
    }

    // Foam
    for (int i = 0; i < 25; i++)
    {
        int x = 510 + (i * 37 + waterfallFrame * 2) % 190;
        int y = 525 + (i * 17) % 28;
        int r = 5 + i % 6;

        int c = (i % 3 == 0) ? WHITE : rgb(210, 240, 248);
        filledCircle(x, y, r, c);
    }

    // Splash
    for (int i = 0; i < 35; i++)
    {
        int x = 600 + ((i * 43 + waterfallFrame * 5) % 220) - 110;
        int d = (i * 23 + waterfallFrame * 3) % 75;
        int y = 535 - d;

        int s = (i % 5 == 0) ? 3 : 1;
        filledCircle(x, y, s, rgb(225, 245, 250));
    }

    // Mist
    int mist = nightMode ? rgb(130, 160, 170)
                         : rgb(205, 230, 235);

    setfillstyle(SOLID_FILL, mist);

    fillellipse(525, 545, 60, 11);
    fillellipse(575, 550, 75, 15);
    fillellipse(635, 549, 85, 16);
    fillellipse(690, 545, 55, 10);
}


// ============================================================
// TREE
// ============================================================

void drawTree(int x, int groundY, int scale)
{
    int trunk = nightMode ? rgb(65, 45, 30)
                          : rgb(100, 62, 32);

    int h = 130 * scale / 100;
    int w = 20  * scale / 100;

    setfillstyle(SOLID_FILL, trunk);
    int t[] =
    {
        x - w,     groundY,
        x - w / 2, groundY - h,
        x + w / 2, groundY - h,
        x + w,     groundY
    };
    fillpoly(4, t);

    // Branches
    setcolor(trunk);
    setlinestyle(SOLID_LINE, 0, 3);
    line(x, groundY - h + 40 * scale / 100,
         x - 35 * scale / 100,
         groundY - h + 5 * scale / 100);

    line(x, groundY - h + 55 * scale / 100,
         x + 40 * scale / 100,
         groundY - h + 20 * scale / 100);

    setlinestyle(SOLID_LINE, 0, 1);

    // Leaves
    int g1 = nightMode ? rgb(18,60,35)  : rgb(25,92,42);
    int g2 = nightMode ? rgb(26,78,43)  : rgb(38,128,50);
    int g3 = nightMode ? rgb(38,95,49)  : rgb(70,158,62);

    int lx[] = {-45,-20,15,45,-55,-25,10,50,-35,0,35};
    int ly[] = {-110,-145,-150,-115,-80,-105,
                -100,-75,-65,-80,-60};

    for (int i = 0; i < 11; i++)
    {
        int c;
        if      (i % 3 == 0) c = g3;
        else if (i % 2 == 0) c = g2;
        else                 c = g1;

        filledCircle(
            x + lx[i] * scale / 100,
            groundY + ly[i] * scale / 100,
            28 * scale / 100, c);
    }
}


// ============================================================
// LAND
// ============================================================

void drawGrassArea()
{
    int ground = nightMode ? rgb(27, 65, 37)
                           : rgb(46, 115, 49);

    setfillstyle(SOLID_FILL, ground);

    int L[] = {0,500,180,500,260,530,
               190,555,90,548,0,565};
    fillpoly(6, L);

    int R[] = {810,515,950,490,1200,495,
               1200,565,1050,550,930,560};
    fillpoly(6, R);

    // Grass blades
    int grass = nightMode ? rgb(45, 90, 48)
                          : rgb(65, 145, 55);
    setcolor(grass);

    for (int i = 0; i < 55; i++)
    {
        int x = (i * 47) % 1200;

        if (x < 250 || x > 900)
        {
            int y = 508 + (i % 4) * 8;
            line(x, y, x - 4, y - 12);
            line(x, y, x + 2, y - 15);
            line(x, y, x + 6, y - 10);
        }
    }
}


// ============================================================
// BUSH
// ============================================================

void drawBush(int x, int y, int size)
{
    int d = nightMode ? rgb(18, 60, 35)  : rgb(25, 92, 42);
    int m = nightMode ? rgb(30, 78, 42)  : rgb(45, 130, 50);
    int l = nightMode ? rgb(38, 90, 45)  : rgb(75, 155, 60);

    filledCircle(x,          y,        size,       d);
    filledCircle(x - size/2, y + 3,    size*3/4,   m);
    filledCircle(x + size/2, y + 2,    size*3/4,   d);
    filledCircle(x,          y-size/2, size*2/3,   l);
}


// ============================================================
// ROCK
// ============================================================

void drawRock(int x, int y, int size)
{
    int dark  = nightMode ? rgb(55, 60, 58)
                          : rgb(85, 88, 78);
    int light = nightMode ? rgb(80, 85, 82)
                          : rgb(135, 130, 115);

    setfillstyle(SOLID_FILL, dark);

    int p[] =
    {
        x - size,     y,
        x - size / 2, y - size,
        x + size / 3, y - size - 7,
        x + size,     y,
        x + size / 2, y + size / 4,
        x - size / 2, y + size / 4
    };
    fillpoly(6, p);

    setcolor(light);
    line(x - size/2, y - size,
         x + size/3, y - size - 7);
    line(x + size/3, y - size - 7,
         x + size/2, y - 3);
}


// ============================================================
// FISH
// ============================================================

void drawFish(int x, int y, int color, bool right)
{
    int d = right ? 1 : -1;

    setfillstyle(SOLID_FILL, color);

    int tail[] =
    {
        x - d*20, y,
        x - d*40, y - 15,
        x - d*40, y + 15
    };
    fillpoly(3, tail);

    fillellipse(x, y, 24, 12);

    // Fin
    int fin[] = { x - d*3, y, x, y + 14, x + d*8, y + 3 };
    fillpoly(3, fin);

    // Eye
    filledCircle(x + d*13, y - 3, 2, BLACK);

    // Bubbles
    setcolor(rgb(180, 225, 235));
    circle(x + d*30, y - 15, 3);
    circle(x + d*38, y - 25, 2);
}


// ============================================================
// BIRDS
// ============================================================

void drawBird(int x, int y, int size, int phase)
{
    setcolor(nightMode ? rgb(190,190,190) : rgb(40,40,35));
    setlinestyle(SOLID_LINE, 0, 2);

    int flap = ((waveFrame + phase) / 5) % 2;

    if (flap)
    {
        arc(x - size, y, 350, 90,  size);
        arc(x + size, y, 90,  190, size);
    }
    else
    {
        arc(x - size, y, 180, 350, size);
        arc(x + size, y, 190, 360, size);
    }

    setlinestyle(SOLID_LINE, 0, 1);
}

void drawBirds()
{
    drawBird(birdX,        130, 12, 0);
    drawBird(birdX + 55,   105, 9,  3);
    drawBird(birdX + 95,   145, 8,  6);
}


// ============================================================
// PERSON BATHING
// ============================================================

void drawPerson()
{
    int x = 680;
    int y = 540;

    int skin     = rgb(205, 145, 95);
    int darkSkin = rgb(155, 100, 65);

    // Head
    filledCircle(x, y - 72, 12, skin);

    // Hair
    setfillstyle(SOLID_FILL, rgb(40, 28, 20));
    fillellipse(x, y - 79, 12, 7);

    // Face dot
    filledCircle(x + 4, y - 73, 1, BLACK);

    // Neck
    setcolor(skin);
    setlinestyle(SOLID_LINE, 0, 5);
    line(x, y - 61, x, y - 55);

    // Body
    setlinestyle(SOLID_LINE, 0, 9);
    line(x, y - 55, x, y - 22);

    // Arms raised enjoying waterfall
    setlinestyle(SOLID_LINE, 0, 6);
    line(x, y - 49, x - 22, y - 35);
    line(x - 22, y - 35, x - 32, y - 52);

    line(x, y - 49, x + 20, y - 33);
    line(x + 20, y - 33, x + 30, y - 50);

    // Shorts
    setfillstyle(SOLID_FILL, rgb(25, 55, 100));
    bar(x - 9, y - 26, x + 9, y - 8);

    // Legs
    setcolor(darkSkin);
    setlinestyle(SOLID_LINE, 0, 6);
    line(x - 5, y - 8, x - 9, y + 14);
    line(x + 5, y - 8, x + 10, y + 14);
    setlinestyle(SOLID_LINE, 0, 1);

    // Splashes
    setcolor(rgb(215, 240, 248));
    arc(x - 10, y + 15, 10, 170, 20);
    arc(x + 17, y + 14, 10, 170, 20);
}


// ============================================================
// FLOWERS
// ============================================================

void drawFlower(int x, int y, int color)
{
    setcolor(rgb(30, 110, 40));
    line(x, y, x, y - 18);

    filledCircle(x - 4, y - 20, 4, color);
    filledCircle(x + 4, y - 20, 4, color);
    filledCircle(x,     y - 24, 4, color);
    filledCircle(x,     y - 17, 4, color);
    filledCircle(x,     y - 20, 3, rgb(250, 210, 50));
