// ======================= VISITOR INTERACTION =======================

const char* getVisitorMessage(int booth, int index) {
    if (booth == 0)
        return index%2 == 0 ? "How does solar power work?"
                            : "Clean energy is amazing!";

    if (booth == 1)
        return index%2 == 0 ? "Look at that robot arm!"
                            : "Can the robot pick it up?";

    return index%2 == 0 ? "Let's explore the planets!"
                        : "Wow! A rocket launch!";
}

void drawSpeechBubble(int vx, int vy, const char *message) {
    settextstyle(DEFAULT_FONT,HORIZ_DIR,1);

    int width = textwidth((char*)message)+20, height = 24;
    int x = vx-width/2, y = vy-112;

    if (x < 5) x = 5;
    if (x+width > W-5) x = W-width-5;

    int bg = rgb(248,248,239), border = rgb(75,80,85);

    box(x+3,y+3,x+width+3,y+height+3,rgb(80,85,82));
    box(x,y,x+width,y+height,bg);
    outline(x,y,x+width,y+height,border);

    int pointer[] = {
        vx-5,y+height, vx+5,y+height, vx,y+height+8
    };
    polygon(pointer,3,bg,border);
    drawText(x+10,y+8,message,rgb(35,42,48),bg);
}

void drawVisitors() {
    // Draw visitors from back to front based on groundY.
    for (int pass = 0; pass < VISITOR_COUNT; pass++) {
        int chosen = -1;

        for (int i = 0; i < VISITOR_COUNT; i++) {
            int rank = 0;

            for (int j = 0; j < VISITOR_COUNT; j++) {
                if (visitors[j].groundY < visitors[i].groundY ||
                    (visitors[j].groundY == visitors[i].groundY && j < i))
                    rank++;
            }

            if (rank == pass) {
                chosen = i;
                break;
            }
        }

        if (chosen >= 0) {
            FairVisitor &v = visitors[chosen];
            drawPerson((int)v.x,v.groundY,v.scale,v.shirtColor,
                       v.phase,v.hasBag,v.state != 1,v.direction == 1);
        }
    }

    // At most one speech bubble per booth.
    for (int booth = 0; booth < 3; booth++) {
        for (int i = 0; i < VISITOR_COUNT; i++) {
            FairVisitor &v = visitors[i];

            if (v.targetBooth == booth && v.state == 1 &&
                v.visitTimer > 20 && v.visitTimer < 150) {
                drawSpeechBubble((int)v.x,v.groundY,
                                 getVisitorMessage(v.targetBooth,i));
                break;
            }
        }
    }
}

void updateVisitors() {
    for (int i = 0; i < VISITOR_COUNT; i++) {
        FairVisitor &v = visitors[i];

        if (v.state == 0) {
            v.x += v.speed*v.direction;
            int target = boothStopX[v.targetBooth];

            if ((v.direction == 1 && v.x >= target) ||
                (v.direction == -1 && v.x <= target)) {
                v.x = target;
                v.state = 1;
                v.visitTimer = 0;
            }
        }
        else if (v.state == 1) {
            v.visitTimer++;

            if (v.visitTimer >= 165+i*20) {
                v.state = 2;
                v.visitTimer = 0;
            }
        }
        else {
            v.x += v.speed*v.direction;

            if ((v.direction == 1 && v.x > W+80) ||
                (v.direction == -1 && v.x < -80)) {
                v.x = v.direction == 1 ? -80 : W+80;
                v.targetBooth = (v.targetBooth+1)%3;
                v.state = 0;
                v.visitTimer = 0;
            }
        }
    }
}

