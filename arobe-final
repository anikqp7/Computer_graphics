void drawSky() {
    for (int y = 0; y < 285; y += 3) {
        double t = (double)y / 285.0;
        int c = mixColor(
            (int)(48+105*t), (int)(125+90*t), (int)(195+40*t),
            (int)(7+13*t), (int)(14+22*t), (int)(35+35*t),
            nightMix
        );
        box(0, y, W, y+3, c);
    }

    if (nightMix > 0.15) {
        for (int i = 0; i < 85; i++) {
            int x = (i*173+37)%W, y = (i*71+18)%210;
            double twinkle = 0.65 + 0.35*sin(animationTime*2+i);
            int b = (int)(210*nightMix*twinkle);
            if (b > 35) putpixel(x, y, rgb(b, b, b+20));
        }
    }

    int sunY = 76 + (int)(105*nightMix);

    if (nightMix < 0.95) {
        filledCircle(1135, sunY, 50,
                     mixColor(244,194,106,90,75,70,nightMix));
        filledCircle(1135, sunY, 38,
                     mixColor(255,214,105,115,87,65,nightMix));
        filledCircle(1135, sunY, 28,
                     mixColor(255,238,170,140,110,80,nightMix));
    }

    if (nightMix > 0.12) {
        int moonY = 145 - (int)(75*nightMix);
        filledCircle(1135, moonY, 29,
                     mixColor(35,48,70,240,238,220,nightMix));
        filledCircle(1148, moonY-8, 26,
                     sceneColor(95,165,215,15,23,48));
    }
}

