// ======================= HELPERS =======================

int clampValue(int v) {
    if (v < 0) return 0;
    if (v > 255) return 255;
    return v;
}

int rgb(int r, int g, int b) {
    return COLOR(clampValue(r), clampValue(g), clampValue(b));
}

int mixColor(int r1, int g1, int b1,
             int r2, int g2, int b2, double t) {
    if (t < 0) t = 0;
    if (t > 1) t = 1;

    return rgb((int)(r1 + (r2-r1)*t),
               (int)(g1 + (g2-g1)*t),
               (int)(b1 + (b2-b1)*t));
}

int sceneColor(int r1, int g1, int b1,
               int r2, int g2, int b2) {
    return mixColor(r1, g1, b1, r2, g2, b2, nightMix);
}

void box(int x1, int y1, int x2, int y2, int c) {
    setcolor(c);
    setfillstyle(SOLID_FILL, c);
    bar(x1, y1, x2, y2);
}

void filledCircle(int x, int y, int r, int c) {
    if (r < 1) r = 1;
    setcolor(c);
    setfillstyle(SOLID_FILL, c);
    fillellipse(x, y, r, r);
}

void filledEllipse(int x, int y, int rx, int ry, int c) {
    if (rx < 1) rx = 1;
    if (ry < 1) ry = 1;
    setcolor(c);
    setfillstyle(SOLID_FILL, c);
    fillellipse(x, y, rx, ry);
}

void polygon(int p[], int n, int fill, int border) {
    setcolor(border);
    setfillstyle(SOLID_FILL, fill);
    fillpoly(n, p);
}

void drawText(int x, int y, const char *s, int c, int bg) {
    setcolor(c);
    setbkcolor(bg);
    outtextxy(x, y, (char*)s);
}

void centeredText(int x1, int x2, int y,
                  const char *s, int c, int bg) {
    setcolor(c);
    setbkcolor(bg);
    outtextxy((x1+x2-textwidth((char*)s))/2, y, (char*)s);
}

void thickLine(int x1, int y1, int x2, int y2, int c, int width) {
    setcolor(c);
    setlinestyle(SOLID_LINE, 0, width > 1 ? THICK_WIDTH : NORM_WIDTH);
    line(x1, y1, x2, y2);
    setlinestyle(SOLID_LINE, 0, NORM_WIDTH);
}

void outline(int x1, int y1, int x2, int y2, int c) {
    setcolor(c);
    rectangle(x1, y1, x2, y2);
}

