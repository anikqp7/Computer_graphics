    int pants = sceneColor(42,52,70,30,37,53);
    int hair = rgb(44,31,25);

    int bob = walking ? (int)(1.5*sin(animationTime*5+phase)) : 0;
    int swing = walking ? (int)(7*s*sin(animationTime*7+phase)) : 0;
    int y = groundY+bob;

    filledEllipse(x,groundY+2,(int)(16*s),(int)(4*s),
                  sceneColor(145,140,129,75,78,77));

    if (bag)
