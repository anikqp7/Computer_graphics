    box(x-(int)(3*s),y-(int)(59*s),
        x+(int)(3*s),y-(int)(50*s),skin);

    int headY = y-(int)(66*s);
    filledEllipse(x,headY,(int)(9*s),(int)(11*s),skin);

    setcolor(hair);
    setfillstyle(SOLID_FILL,hair);
    pieslice(x,headY-(int)(3*s),0,180,(int)(9*s));

    filledCircle(x+(right ? 3 : -3),headY-1,1,rgb(35,28,24));
