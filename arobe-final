    thickLine(x-(int)(5*s),y-(int)(25*s),
              x-(int)(5*s)+swing,y-(int)(3*s),pants,3);

    thickLine(x+(int)(5*s),y-(int)(25*s),
              x+(int)(5*s)-swing,y-(int)(3*s),pants,3);

    thickLine(x-(int)(5*s)+swing,y-(int)(3*s),
              x-(int)(12*s)+swing,y,rgb(28,30,33),2);

    thickLine(x+(int)(5*s)-swing,y-(int)(3*s),
              x+(int)(12*s)-swing,y,rgb(28,30,33),2);

    int body[] = {
        x-(int)(11*s),y-(int)(52*s),
        x+(int)(11*s),y-(int)(52*s),
        x+(int)(8*s), y-(int)(27*s),
        x-(int)(8*s), y-(int)(27*s)
    };
    polygon(body,4,shirt,shirt);

    if (walking) {
        thickLine(x-(int)(10*s),y-(int)(46*s),
                  x-(int)(15*s)-swing/2,y-(int)(28*s),skin,2);
        thickLine(x+(int)(10*s),y-(int)(46*s),
                  x+(int)(15*s)+swing/2,y-(int)(28*s),skin,2);
    } else {
        int gesture = (int)(2*sin(animationTime*1.5+phase));

        if (right) {
            thickLine(x+(int)(10*s),y-(int)(46*s),
                      x+(int)(25*s),y-(int)(38*s)+gesture,skin,2);
            thickLine(x-(int)(10*s),y-(int)(46*s),
                      x-(int)(12*s),y-(int)(29*s),skin,2);
