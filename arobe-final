// ======================= UPDATE AND INPUT =======================

void updateScene() {
    if (paused) return;

    animationTime += 0.025;

    windAngle += 3.5;
    if (windAngle >= 360) windAngle -= 360;

    orbitAngle += 1.2;
    if (orbitAngle >= 7200) orbitAngle -= 7200;

    armTime += 0.035;
    selectionPulse = (sin(animationTime*4)+1)/2;

    double target = nightTarget ? 1.0 : 0.0;

    if (nightMix < target) {
        nightMix += 0.008;
        if (nightMix > target) nightMix = target;
    } else if (nightMix > target) {
        nightMix -= 0.008;
        if (nightMix < target) nightMix = target;
    }

    cloudX1 += 0.70;
    cloudX2 += 0.45;
    cloudX3 += 0.30;

    if (cloudX1 > W+100) cloudX1 = -120;
    if (cloudX2 > W+100) cloudX2 = -120;
    if (cloudX3 > W+100) cloudX3 = -120;

    birdX += 1.5;
    if (birdX > W+180) birdX = -180;

    updateVisitors();

    if (rocketActive) {
        rocketHeight += 3.5;

        if (rocketHeight > 150) {
            rocketHeight = 0;
            rocketActive = false;
        }
    }
}

bool handleInput() {
    // Mouse button click
    if (ismouseclick(WM_LBUTTONDOWN)) {
        int mx, my;
        getmouseclick(WM_LBUTTONDOWN, mx, my);

        if (my >= 686 && my <= 713) {
            for (int i = 0; i < 8; i++) {
                int x = 8 + i * 158;

                if (mx >= x && mx <= x + 149) {
                    if (i >= 0 && i <= 2) {
                        selected = i + 1;
                    }
                    else if (i == 3) {
                        selected = 0;
                    }
                    else if (i == 4) {
                        if (!rocketActive) {
                            rocketActive = true;
                            rocketHeight = 0;
                        }
                    }
                    else if (i == 5) {
                        nightTarget = !nightTarget;
                    }
                    else if (i == 6) {
                        paused = !paused;
                    }
                    else if (i == 7) {
                        return false;
                    }

                    break;
                }
            }
        }
    }

    // Keyboard controls
    if (!kbhit())
        return true;

    int key = getch();

    if (key == 0 || key == 224) {
        getch();
        return true;
    }

    if (key == 27)
        return false;

    if (key >= '0' && key <= '3') {
        selected = key - '0';
    }
    else if (key == 'n' || key == 'N') {
        nightTarget = !nightTarget;
    }
    else if (key == ' ') {
        paused = !paused;
    }
    else if ((key == 'r' || key == 'R') && !rocketActive) {
        rocketActive = true;
        rocketHeight = 0;
    }

    return true;
}

// ======================= MAIN =======================

int main() {
    initwindow(W,H,"Interactive Science and Technology Fair");
    initializeVisitors();

    bool running = true;

    while (running) {
        setactivepage(activePage);
        cleardevice();

        drawScene();

        setvisualpage(activePage);
        activePage = 1-activePage;

        updateScene();
        running = handleInput();
        delay(16);
    }

    closegraph();
    return 0;
}
