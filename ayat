void box(int x1, int y1, int x2, int y2, int color) {
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    bar(x1, y1, x2, y2);
}

void outline(int x1, int y1, int x2, int y2, int color) {
    setcolor(color);
    rectangle(x1, y1, x2, y2);
}

void oval(int x, int y, int rx, int ry, int color) {
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    fillellipse(x, y, rx, ry);
}

void circleFill(int x, int y, int radius, int color) {
    oval(x, y, radius, radius, color);
}

void polygon(int* points, int count, int color) {
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    fillpoly(count, points);
}

void textAt(int x, int y, const char* text, int color, int bg) {
    setcolor(color);
    setbkcolor(bg);
    outtextxy(x, y, const_cast<char*>(text));
}

void centerText(
    int x1, int x2, int y,
    const char* text, int color, int bg
) {
    setcolor(color);
    setbkcolor(bg);

    int width = textwidth(const_cast<char*>(text));
    int x = (x1 + x2 - width) / 2;

    outtextxy(x, y, const_cast<char*>(text));
}

void cross(int x, int y, int size, int color) {
    box(x - size / 3, y - size, x + size / 3, y + size, color);
    box(x - size, y - size / 3, x + size, y + size / 3, color);
}

void gradientBox(
    int x1, int y1, int x2, int y2,
    int r1, int g1, int b1,
    int r2, int g2, int b2
) {
    int height = y2 - y1;
    if (height <= 0) return;

    for (int y = y1; y <= y2; y++) {
        double t = (double)(y - y1) / height;

        int r = (int)(r1 + (r2 - r1) * t);
        int g = (int)(g1 + (g2 - g1) * t);
        int b = (int)(b1 + (b2 - b1) * t);

        setcolor(COLOR(r, g, b));
        line(x1, y, x2, y);
    }
}

void panel(
    int x1, int y1, int x2, int y2,
    int fill, int border
) {
    box(x1 + 4, y1 + 5, x2 + 4, y2 + 5, COLOR(139, 158, 160));
    box(x1, y1, x2, y2, fill);
    outline(x1, y1, x2, y2, border);
}

void depthBox(
    int x, int y, int w, int h, int d,
    int front, int top, int side
) {
    int topPoints[] = {
        x, y,
        x + d, y - d,
        x + w + d, y - d,
        x + w, y
    };

    int sidePoints[] = {
        x + w, y,
        x + w + d, y - d,
        x + w + d, y + h - d,
        x + w, y + h
    };

    polygon(topPoints, 4, top);
    polygon(sidePoints, 4, side);
    box(x, y, x + w, y + h, front);

    setcolor(COLOR(102, 124, 128));
    line(x, y, x + w, y);
    line(x + w, y, x + w + d, y - d);
    line(x + w, y, x + w, y + h);
}

