// ============================================================
// PATIENT DRAWING
// ============================================================

void standingPatient(const Patient& p) {
    int x = (int)p.x;
    int y = (int)p.y;

    int skin = COLOR(225, 180, 145);
    int swing = 0;

    if (p.state == MOVING_TO_BED || p.state == LEAVING)
        swing = (int)(5 * sin(animTime * 5 + p.id));

    oval(x + 3, y + 26, 17, 5, COLOR(159, 178, 176));

    setcolor(COLOR(48, 65, 75));
    setlinestyle(SOLID_LINE, 0, 4);

    line(x - 5, y + 7, x - 7 + swing, y + 23);
    line(x + 5, y + 7, x + 7 - swing, y + 23);

    setlinestyle(SOLID_LINE, 0, 1);

    box(x - 9, y - 14, x + 10, y + 9, priorityColor(p.priority));
    box(x + 7, y - 14, x + 11, y + 9, COLOR(93, 108, 106));

    setcolor(skin);
    line(x - 9, y - 10, x - 15, y + 3);
    line(x + 10, y - 10, x + 16, y + 3);

    circleFill(x, y - 24, 9, skin);
    box(x - 8, y - 33, x + 8, y - 29, COLOR(55, 45, 40));

    char label[24];
    sprintf(label, "P%d", p.id);

    int labelWidth = textwidth(label) + 8;
    int left = x - labelWidth / 2;

    box(left, y + 29, left + labelWidth, y + 41, COLOR(242, 250, 248));
    outline(left, y + 29, left + labelWidth, y + 41, COLOR(150, 179, 177));
    textAt(left + 4, y + 31, label, BLACK, COLOR(242, 250, 248));
}

void patientOnBed(const Patient& p) {
    if (p.bed < 0 || p.bed >= BEDS)
        return;

    int x = bedX[p.bed];
    int y = bedY[p.bed];

    // Patient head
    circleFill(x - 68, y - 11, 11, COLOR(225, 180, 145));

    // Blanket indicates triage priority
    box(x - 55, y - 24, x + 65, y + 2, priorityColor(p.priority));
    box(x + 60, y - 24, x + 65, y + 2, COLOR(100, 120, 118));

    setcolor(COLOR(244, 247, 243));
    line(x - 50, y - 20, x + 55, y - 20);

    char label[60];
    sprintf(label, "P%d - %s", p.id, priorityName(p.priority));

    textAt(
        x - 100, y + 30,
        label,
        COLOR(31, 58, 68),
        COLOR(234, 244, 242)
    );

    // Treatment progress bar
    int left = x - 100;
    int top = y + 45;
    int width = 190;

    box(left, top, left + width, top + 8, COLOR(83, 105, 108));

    double progress = p.treatmentTime / p.treatmentDuration;
    if (progress > 1.0) progress = 1.0;

    int filled = (int)(width * progress);

    if (filled > 0)
        box(left, top, left + filled, top + 8, COLOR(58, 203, 125));
}

void drawPatients() {
    for (size_t i = 0; i < patients.size(); i++) {
        if (patients[i].state == TREATMENT)
            patientOnBed(patients[i]);
        else if (patients[i].state != FINISHED)
            standingPatient(patients[i]);
    }
}

// Doctors are drawn after patients so animated hands remain visible.
void drawDoctors() {
    for (int i = 0; i < BEDS; i++) {
        bool active = isBedTreating(i);

        // Active doctor stands near bed; otherwise beside monitor.
        int x = active ? 790 : 930;
        int y = bedY[i] - 2;

        doctor(x, y, active, i);
    }
}

