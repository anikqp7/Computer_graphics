void scene() {
    background();

    wallDecorations();
    waitingArea();
    treatmentPanel();

    cabinet();
    exitDoor();

    for (int i = 0; i < BEDS; i++)
        drawBed(i);

    drawPatients();
    drawDoctors();

    ambulance((int)ambulanceX, 660);

    header();
    dashboard();
}

// ============================================================
// MAIN
// ============================================================

int main() {
    srand((unsigned int)time(NULL));

    initwindow(W, H, "Hospital Emergency Room Simulation");

    for (int i = 0; i < 3; i++)
        addPatient();

    int page = 0;
    bool running = true;

    while (running) {
        setactivepage(page);
        cleardevice();

        scene();

        setvisualpage(page);
        page = 1 - page;

        update();
        running = input();

        delay(16);
    }

    closegraph();
    return 0;
}
