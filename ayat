// ============================================================
// PATIENT LOGIC
// ============================================================

int countState(int state) {
    int count = 0;

    for (size_t i = 0; i < patients.size(); i++)
        if (patients[i].state == state)
            count++;

    return count;
}

void addPatient() {
    if (countState(WAITING) >= MAX_WAITING)
        return;

    Patient p;
    int chance = rand() % 100;

    p.id = nextPatientId++;
    p.priority = chance < 20 ? 1 : chance < 55 ? 2 : 3;
    p.state = WAITING;
    p.bed = -1;

    p.x = p.targetX = 45;
    p.y = p.targetY = 575;

    p.waitingTime = 0;
    p.treatmentTime = 0;

    if (p.priority == 1)
        p.treatmentDuration = 650 + rand() % 250;
    else if (p.priority == 2)
        p.treatmentDuration = 500 + rand() % 200;
    else
        p.treatmentDuration = 350 + rand() % 200;

    patients.push_back(p);
    totalArrived++;
}

bool movePatient(Patient& p, double tx, double ty, double speed) {
    double dx = tx - p.x;
    double dy = ty - p.y;
    double distance = sqrt(dx * dx + dy * dy);

    if (distance < speed || distance < 0.1) {
        p.x = tx;
        p.y = ty;
        return true;
    }

    p.x += dx / distance * speed;
    p.y += dy / distance * speed;

    return false;
}

void updateWaitingPositions() {
    int index = 0;

    for (size_t i = 0; i < patients.size(); i++) {
        Patient& p = patients[i];

        if (p.state != WAITING)
            continue;

        p.targetX = 80 + (index % 4) * 75;
        p.targetY = 365 + (index / 4) * 80;

        index++;
    }
}

bool isBedOccupied(int bed) {
    for (size_t i = 0; i < patients.size(); i++) {
        if (patients[i].bed == bed &&
            (patients[i].state == MOVING_TO_BED ||
             patients[i].state == TREATMENT)) {
            return true;
        }
    }

    return false;
}

bool isBedTreating(int bed) {
    for (size_t i = 0; i < patients.size(); i++) {
        if (patients[i].bed == bed &&
            patients[i].state == TREATMENT) {
            return true;
        }
    }

    return false;
}

void assignBeds() {
    for (int b = 0; b < BEDS; b++) {
        if (isBedOccupied(b))
            continue;

        int best = -1;

        for (size_t i = 0; i < patients.size(); i++) {
            Patient& p = patients[i];

            if (p.state != WAITING)
                continue;

            if (best == -1 ||
                p.priority < patients[best].priority ||
                (p.priority == patients[best].priority &&
                 p.waitingTime > patients[best].waitingTime)) {
                best = (int)i;
            }
        }

        if (best != -1) {
            Patient& p = patients[best];

            p.bed = b;
            p.state = MOVING_TO_BED;
            p.targetX = bedX[b];
            p.targetY = bedY[b];
        }
    }
}

