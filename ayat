// ============================================================
// UPDATE
// ============================================================

void update() {
    if (paused)
        return;

    for (int step = 0; step < speedLevel; step++) {
        animTime += 0.025;

        ambulanceX += 2.0;

        if (ambulanceX > W + 200)
            ambulanceX = -200;

        if (++arrivalTimer >= nextArrival) {
            addPatient();
            arrivalTimer = 0;
            nextArrival = 180 + rand() % 180;
        }

        assignBeds();
        updateWaitingPositions();

        for (size_t i = 0; i < patients.size(); i++) {
            Patient& p = patients[i];

            if (p.state == WAITING) {
                p.waitingTime++;
                movePatient(p, p.targetX, p.targetY, 1.2);
            }

            else if (p.state == MOVING_TO_BED) {
                if (movePatient(p, p.targetX, p.targetY, 1.5)) {
                    p.state = TREATMENT;
                    p.treatmentTime = 0;
                }
            }

            else if (p.state == TREATMENT) {
                p.treatmentTime++;

                if (p.treatmentTime >= p.treatmentDuration) {
                    p.state = LEAVING;
                    p.bed = -1;
                    p.targetX = 1175;
                    p.targetY = 520;
                }
            }

            else if (p.state == LEAVING) {
                if (movePatient(p, p.targetX, p.targetY, 1.5)) {
                    p.state = FINISHED;
                    totalDischarged++;
                }
            }
        }

        for (size_t i = 0; i < patients.size();) {
            if (patients[i].state == FINISHED)
                patients.erase(patients.begin() + i);
            else
                i++;
        }
    }
}

// ============================================================
// INPUT
// ============================================================

bool input() {
    while (kbhit()) {
        int key = getch();

        if (key == 0 || key == 224) {
            getch();
            continue;
        }

        if (key == 27)
            return false;

        if (key == ' ')
            paused = !paused;

        else if (key == 'n' || key == 'N')
            addPatient();

        else if (key == 'd' || key == 'D')
            night = !night;

        else if ((key == '+' || key == '=') && speedLevel < 3)
            speedLevel++;

        else if ((key == '-' || key == '_') && speedLevel > 1)
            speedLevel--;
    }

    return true;
}

