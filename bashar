// ============================================================
// UPDATE
// ============================================================

void updateAnimation()
{
    if (paused)
        return;

    frameNo += animationSpeed;
    carX += animationSpeed + 1;

    if (carX > WIDTH + 100)
        carX = -100;

    // Keep values bounded.
    if (frameNo >= 360000)
        frameNo = 0;
}


// ============================================================
// KEYBOARD
// ============================================================

bool handleKeyboard()
{
    while (kbhit())
    {
        int key = getch();

        // Ignore extended-key prefix and its following code.
        if (key == 0 || key == 224)
        {
            getch();
            continue;
        }

        if (key == 27)
            return false;

        if (key >= '1' && key <= '8')
        {
            int index = key - '1';
            buildingOn[index] = !buildingOn[index];
        }

        if (key == 'm' || key == 'M')
            smartMode = !smartMode;

        if (key == 'd' || key == 'D')
            nightMode = !nightMode;

        if (key == 'a' || key == 'A')
            autoLife = !autoLife;

        if (key == 'h' || key == 'H')
            showHelp = !showHelp;

        if (key == ' ')
            paused = !paused;

        if ((key == '+' || key == '=') && animationSpeed < 6)
            animationSpeed++;

        if ((key == '-' || key == '_') && animationSpeed > 1)
            animationSpeed--;
    }

    return true;
}


// ============================================================
// MAIN
// ============================================================

int main()
{
    initwindow(WIDTH, HEIGHT, "Smart Village Power Saver");

    bool running = true;

    while (running)
    {
        currentPage = 1 - currentPage;

        setactivepage(currentPage);
        cleardevice();

        drawScene();
        setvisualpage(currentPage);

        running = handleKeyboard();
        updateAnimation();

        delay(25);
    }

    closegraph();
    return 0;
}
