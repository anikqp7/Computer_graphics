// ============================================================
// DASHBOARD
// ============================================================

void progressBar(int x, int y, int width, int percent, int color)
{
    if (percent < 0) percent = 0;
    if (percent > 100) percent = 100;

    box(x, y, x + width, y + 9, rgb(15, 35, 45));
    outline(x, y, x + width, y + 9, rgb(70, 130, 135));

    int filled = width * percent / 100;
    if (filled > 0)
        box(x + 1, y + 1, x + filled, y + 8, color);
}

void drawDashboard()
{
    int x = 850;
    int y = 82;
    int w = 330;
    int h = 205;

    box(x, y, x + w, y + h, rgb(8, 26, 31));
    outline(x, y, x + w, y + h, rgb(70, 225, 135));

    textAt(x + 12, y + 10, "// ENERGY DASHBOARD",
           rgb(120, 255, 180));

    int lit = countLitWindows();

    // Illustrative simulation values.
    int load = 10 + lit * 2;
    if (load > 100) load = 100;

    int solar = nightMode ? 5 : 75 + (frameNo / 40) % 20;
    int battery = 68 + (frameNo / 150) % 12;
    int savings = smartMode ? 62 : 15;

    char text[100];

    sprintf(text, "Village load: %d%%", load);
    textAt(x + 12, y + 35, text, rgb(225, 240, 235));
    progressBar(x + 12, y + 50, 300, load, rgb(255, 195, 80));

    sprintf(text, "Solar output: %d%%", solar);
    textAt(x + 12, y + 68, text, rgb(225, 240, 235));
    progressBar(x + 12, y + 83, 300, solar, rgb(80, 200, 255));

    sprintf(text, "Battery: %d%%", battery);
    textAt(x + 12, y + 101, text, rgb(225, 240, 235));
    progressBar(x + 12, y + 116, 300, battery, rgb(90, 235, 140));

    sprintf(text, "Power savings: %d%%", savings);
    textAt(x + 12, y + 134, text, rgb(225, 240, 235));
    progressBar(x + 12, y + 149, 300, savings, rgb(85, 230, 205));

    sprintf(text, "Lit rooms: %d   Grid: ONLINE", lit);
    textAt(x + 12, y + 177, text, rgb(145, 250, 190));
}


