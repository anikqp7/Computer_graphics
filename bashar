const int WIDTH = 1200;
const int HEIGHT = 700;

bool nightMode = true;
bool smartMode = true;
bool autoLife = true;
bool paused = false;
bool showHelp = true;

int frameNo = 0;
int carX = -100;
int animationSpeed = 2;
int currentPage = 0;

// Eight village buildings
const int BUILDINGS = 8;

int bx[BUILDINGS] = {55, 195, 340, 485, 665, 810, 945, 1065};
int bw[BUILDINGS] = {115, 115, 115, 115, 115, 105, 100, 85};
int bh[BUILDINGS] = {100, 145, 215, 255, 285, 205, 105, 230};

bool buildingOn[BUILDINGS] =
{
    true, true, true, true,
    true, true, true, true
};


// ============================================================
// HELPERS
// ============================================================

int rgb(int r, int g, int b)
{
    return COLOR(r, g, b);
}

void box(int x1, int y1, int x2, int y2, int color)
{
    setfillstyle(SOLID_FILL, color);
    bar(x1, y1, x2, y2);
}

void dot(int x, int y, int radius, int color)
{
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    fillellipse(x, y, radius, radius);
}

void outline(int x1, int y1, int x2, int y2, int color)
{
    setcolor(color);
    rectangle(x1, y1, x2, y2);
}

void textAt(int x, int y, const char *text, int color)
{
    setcolor(color);
    outtextxy(x, y, const_cast<char *>(text));
}

void filledPoly(int count, int points[], int color)
{
    setcolor(color);
    setfillstyle(SOLID_FILL, color);
    fillpoly(count, points);
}


// ============================================================
// BACKGROUND
// ============================================================

void drawBackground()
{
    int topR, topG, topB;
    int bottomR, bottomG, bottomB;

    if (nightMode)
    {
        topR = 5; topG = 12; topB = 30;
        bottomR = 12; bottomG = 30; bottomB = 58;
    }
    else
    {
        topR = 35; topG = 100; topB = 150;
        bottomR = 135; bottomG = 195; bottomB = 210;
    }

    for (int y = 0; y < HEIGHT; y += 5)
    {
        int r = topR + (bottomR - topR) * y / HEIGHT;
        int g = topG + (bottomG - topG) * y / HEIGHT;
        int b = topB + (bottomB - topB) * y / HEIGHT;

        box(0, y, WIDTH, y + 5, rgb(r, g, b));
    }

    if (nightMode)
    {
        for (int i = 0; i < 65; i++)
        {
            int x = 25 + (i * 137) % 1150;
            int y = 85 + (i * 83) % 345;
            int radius = ((frameNo / 12 + i) % 9 == 0) ? 2 : 1;

            dot(x, y, radius, rgb(205, 225, 240));
        }
    }
    else
    {
        dot(1110, 95, 34, rgb(255, 220, 110));
        dot(1110, 95, 26, rgb(255, 240, 170));
    }
}


