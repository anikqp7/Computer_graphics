// ============================================================
// BUILDING WINDOW STATE
// ============================================================

bool windowLit(int building, int row, int col)
{
    if (!buildingOn[building])
        return false;

    if (!nightMode)
        return false;

    if (!smartMode)
        return true;

    // In smart mode, only selected rooms use lighting.
    int period = autoLife ? frameNo / 100 : 0;

    return ((building * 7 + row * 3 + col * 5 + period) % 5 == 0);
}

int countLitWindows()
{
    int count = 0;

    for (int i = 0; i < BUILDINGS; i++)
    {
        int rows = (bh[i] - 45) / 35;

        if (rows < 1)
            rows = 1;

        int cols = (bw[i] >= 100) ? 3 : 2;

        for (int row = 0; row < rows; row++)
        {
            for (int col = 0; col < cols; col++)
            {
                if (windowLit(i, row, col))
                    count++;
            }
        }
    }

    return count;
}


// ============================================================
// ENERGY CONNECTIONS
// ============================================================

void drawEnergyConnections()
{
    int hubX = 600;
    int hubY = 300;

    for (int i = 0; i < BUILDINGS; i++)
    {
        if (!buildingOn[i])
            continue;

        int targetX = bx[i] + bw[i] / 2;
        int targetY = 570 - bh[i] - 14;

        // Quadratic curve from central hub to building.
        int controlX = (hubX + targetX) / 2;
        int controlY = 205;

        int prevX = hubX;
        int prevY = hubY;

        setcolor(nightMode ? rgb(35, 115, 130)
                           : rgb(40, 145, 145));

        for (int step = 1; step <= 40; step++)
        {
            double t = step / 40.0;
            double one = 1.0 - t;

            int px = (int)(one * one * hubX
                     + 2 * one * t * controlX
                     + t * t * targetX);

            int py = (int)(one * one * hubY
                     + 2 * one * t * controlY
                     + t * t * targetY);

            line(prevX, prevY, px, py);

            prevX = px;
            prevY = py;
        }

        // Moving energy particle.
        double t = ((frameNo + i * 13) % 100) / 100.0;
        double one = 1.0 - t;

        int px = (int)(one * one * hubX
                 + 2 * one * t * controlX
                 + t * t * targetX);

        int py = (int)(one * one * hubY
                 + 2 * one * t * controlY
                 + t * t * targetY);

        dot(px, py, 5, rgb(35, 110, 115));
        dot(px, py, 2, rgb(145, 255, 240));
    }

    dot(hubX, hubY, 9, rgb(25, 110, 115));
    dot(hubX, hubY, 4, rgb(150, 255, 240));
}


// ============================================================
// SOLAR PANELS
// ============================================================

void drawSolarPanel(int x, int y, int width)
{
    int panelColor = nightMode ? rgb(15, 60, 95)
                               : rgb(25, 100, 140);

    box(x, y, x + width, y + 11, panelColor);
    outline(x, y, x + width, y + 11, rgb(65, 190, 220));

    setcolor(rgb(45, 150, 185));

    for (int px = x + 12; px < x + width; px += 12)
        line(px, y + 1, px, y + 10);

    line(x, y + 5, x + width, y + 5);
}


// ============================================================
// BUILDINGS
// ============================================================

void drawBuilding(int index)
{
    int x = bx[index];
    int width = bw[index];
    int height = bh[index];
    int ground = 570;
    int top = ground - height;

    int accents[BUILDINGS] =
    {
        rgb(230, 150, 80),
        rgb(240, 140, 110),
        rgb(70, 210, 205),
        rgb(120, 195, 225),
        rgb(105, 235, 135),
        rgb(205, 220, 85),
        rgb(240, 165, 75),
        rgb(185, 120, 230)
    };

    int accent = accents[index];

    int body = nightMode ? rgb(15, 37, 48)
                         : rgb(105, 145, 150);

    if (index == 0 || index == 1 || index == 6)
        body = nightMode ? rgb(85, 60, 47)
                         : rgb(190, 155, 115);

    box(x, top, x + width, ground, body);

    // Building outline and glow-like border.
    outline(x - 2, top - 2, x + width + 2, ground + 2,
            rgb(35, 90, 85));

    outline(x, top, x + width, ground, accent);

    // Roof for smaller houses.
    if (index == 0 || index == 1 || index == 6)
    {
        int roof[] =
        {
            x - 7, top,
            x + width / 2, top - 27,
            x + width + 7, top
        };

        filledPoly(3, roof,
                   nightMode ? rgb(120, 55, 45)
                             : rgb(175, 80, 55));
    }
    else
    {
        box(x - 4, top - 6, x + width + 4, top,
            rgb(25, 65, 65));

        drawSolarPanel(x + width / 4, top - 18, width / 2);
    }

    int rows = (height - 45) / 35;
    if (rows < 1)
        rows = 1;

    int cols = width >= 100 ? 3 : 2;
    int windowW = 20;
    int windowH = 23;
    int gap = (width - cols * windowW) / (cols + 1);

    for (int row = 0; row < rows; row++)
    {
        for (int col = 0; col < cols; col++)
        {
            int wx = x + gap + col * (windowW + gap);
            int wy = top + 20 + row * 35;

            bool lit = windowLit(index, row, col);

            if (lit)
            {
                box(wx - 2, wy - 2, wx + windowW + 2,
                    wy + windowH + 2, rgb(120, 120, 75));

                box(wx, wy, wx + windowW, wy + windowH,
                    rgb(255, 245, 175));
            }
            else
            {
                box(wx, wy, wx + windowW, wy + windowH,
                    nightMode ? rgb(13, 40, 50)
                              : rgb(80, 155, 180));
            }

            outline(wx, wy, wx + windowW, wy + windowH, accent);

            setcolor(lit ? rgb(200, 185, 120) : accent);
            line(wx + windowW / 2, wy,
                 wx + windowW / 2, wy + windowH);

            line(wx, wy + windowH / 2,
                 wx + windowW, wy + windowH / 2);
        }
    }

    // Entrance
    int doorX = x + width / 2 - 9;
    box(doorX, ground - 23, doorX + 18, ground,
        rgb(28, 35, 35));

    outline(doorX, ground - 23, doorX + 18, ground, accent);

    // Building number
    char label[20];
    sprintf(label, "BLDG %d", index + 1);

    settextstyle(DEFAULT_FONT, HORIZ_DIR, 1);
    textAt(x + 8, ground + 7, label, accent);

    if (!buildingOn[index])
        textAt(x + 10, top + 5, "OFF", rgb(255, 110, 100));
}


